# Set these as Vercel Project → Settings → Environment Variables → Production
# (and Preview, if you want preview deployments to also hit production data —
# usually you don't; point Preview at a staging API instead if one exists).
#
# Do not put this file's real values into admin/.env.local — that file is for
# local development only and should keep pointing at localhost:8080.

NEXT_PUBLIC_API_BASE_URL=https://api.enchantedenergystore.com/api
