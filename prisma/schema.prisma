generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SeoEntityType {
  PRODUCT
  CATEGORY
  COLLECTION
  HOME
  SERVICE
  GUIDE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ContactLeadStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

enum ContactLeadSource {
  GENERAL
  CUSTOM_BRACELET
}

enum ServiceBookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FaqEntityType {
  PRODUCT
  CATEGORY
  GLOBAL
  GUIDE
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CATEGORY_VIEW
  COLLECTION_VIEW
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_STARTED
  ORDER_COMPLETED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  statusHistories OrderStatusHistory[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                      String        @id @default(cuid())
  name                    String
  slug                    String        @unique
  sku                     String        @unique
  shortDescription        String?
  longDescription         String?
  storySummary            String?
  spiritualBenefitSummary String?
  usageGuide              String?
  careInstructions        String?
  price                   Decimal       @db.Decimal(10, 2)
  mrp                     Decimal       @db.Decimal(10, 2)
  discountPercent         Decimal       @default(0) @db.Decimal(5, 2)
  currency                String        @default("INR")
  stockStatus             StockStatus   @default(IN_STOCK)
  inventoryQuantity       Int           @default(0)
  lowStockThreshold       Int           @default(5)
  categoryId              String
  status                  ProductStatus @default(DRAFT)
  priority                Int           @default(0)
  badge                   String?
  attributes              Json?
  publishedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  searchVector            Unsupported("tsvector")?

  category           Category            @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  collectionProducts CollectionProduct[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]

  @@index([status])
  @@index([categoryId])
  @@index([priority])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  imageUrl        String
  thumbnailUrl    String?
  cardUrl         String?
  detailUrl       String?
  storageKey      String?
  storageProvider String?
  mimeType        String?
  sizeBytes       Int?
  altText         String?
  title           String?
  width           Int?
  height          Int?
  sortOrder       Int      @default(0)
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collectionProducts CollectionProduct[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model SeoMetadata {
  id                 String        @id @default(cuid())
  entityType         SeoEntityType
  entityId           String
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  twitterTitle       String?
  twitterDescription String?
  twitterImageUrl    String?
  schemaType         String?
  noindex            Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  type              CouponType
  value             Decimal    @db.Decimal(10, 2)
  minOrderAmount    Decimal?   @db.Decimal(10, 2)
  maxDiscountAmount Decimal?   @db.Decimal(10, 2)
  startDate         DateTime?
  endDate           DateTime?
  usageLimit        Int?
  usedCount         Int        @default(0)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([code])
}

model Cart {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  userEmail      String?
  userPhone      String?
  couponCode     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          CartItem[]

  @@index([sessionId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int
  priceAtAdd Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress Json
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal       @db.Decimal(10, 2)
  couponCode      String?
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerEmail])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  sku             String
  imageUrl        String?
  priceAtPurchase Decimal  @db.Decimal(10, 2)
  quantity        Int
  subtotal        Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id               String      @id @default(cuid())
  orderId          String
  oldStatus        OrderStatus
  newStatus        OrderStatus
  note             String?
  changedByAdminId String?
  createdAt        DateTime    @default(now())

  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByAdmin AdminUser? @relation(fields: [changedByAdminId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("mock")
  providerPaymentId String?
  providerOrderId   String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model ContactLead {
  id        String            @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  location  String?
  message   String
  status    ContactLeadStatus @default(NEW)
  source    ContactLeadSource @default(GENERAL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Service {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  priceLabel  String?
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings ServiceBooking[]

  @@index([isActive])
}

model ServiceBooking {
  id        String               @id @default(cuid())
  serviceId String
  name      String
  email     String
  phone     String?
  message   String?
  status    ServiceBookingStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  customerName       String
  customerEmail      String
  rating             Int
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
}

model Guide {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  bodyHtml      String
  coverImageUrl String?
  tags          String[]      @default([])
  status        ProductStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model Faq {
  id         String        @id @default(cuid())
  entityType FaqEntityType
  entityId   String?
  question   String
  answer     String
  sortOrder  Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([entityType, entityId])
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  type         AnalyticsEventType
  visitorId    String
  sessionId    String?
  path         String?
  productId    String?
  categoryId   String?
  collectionId String?
  searchQuery  String?
  resultCount  Int?
  metadata     Json?
  createdAt    DateTime           @default(now())

  @@index([type, createdAt])
  @@index([visitorId])
  @@index([productId])
}
