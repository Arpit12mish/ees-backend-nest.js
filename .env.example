DATABASE_URL=postgresql://user:password@localhost:5432/eesbackend
PORT=8080
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=Admin@123456
UPLOAD_DRIVER=local
MAX_UPLOAD_SIZE_MB=5
BODY_LIMIT=1mb

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# Local development:
# UPLOAD_DRIVER=local

# Cloudflare R2 production:
# UPLOAD_DRIVER=r2
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_BUCKET=ees-product-images
# R2_PUBLIC_BASE_URL=https://images.yourdomain.com

# AWS S3 production:
# UPLOAD_DRIVER=s3
# AWS_S3_REGION=ap-south-1
# AWS_S3_BUCKET=ees-product-images
# AWS_S3_ACCESS_KEY_ID=<iam-access-key-id>
# AWS_S3_SECRET_ACCESS_KEY=<iam-secret-access-key>
# AWS_S3_PUBLIC_BASE_URL=https://images.yourdomain.com   # optional: CloudFront/custom domain in front of the bucket
#                                                          # omit to use the default https://<bucket>.s3.<region>.amazonaws.com URL

# Email (Mailjet) — optional. If unset, emails are silently skipped (logged only);
# the contact form still saves leads to the database either way.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Enchanted Energy Store
CONTACT_NOTIFICATION_EMAIL=enchantedenergystore@gmail.com
