NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: exact R2/CDN image hostname for production (see next.config.ts)
NEXT_PUBLIC_IMAGE_HOSTNAME=
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Google Search Console HTML tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only secret (deliberately NOT prefixed NEXT_PUBLIC_ — never sent to
# the browser). Shared with the backend's REVALIDATE_SECRET so
# src/app/api/revalidate/route.ts only accepts calls from the backend.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=
